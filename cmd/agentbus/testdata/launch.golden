=== claude openrouter
--- turn t_1 harness="claude" access="openrouter" model="deepseek/deepseek-v4.1-flash" read_only=false
arg "-p"
arg "--output-format"
arg "json"
arg "--append-system-prompt"
arg "You work through AgentBus, in session s1. A turn is one message to you, your reply and your changes.\nYour folder is usually your session's own copy of the person's folder. Your edits stay in the copy. They reach the person's folder only when a turn is applied.\nUse the tools of the agentbus MCP server for AgentBus: list and ask other agents, review, read and stop turns, search this session. AgentBus agents are saved setups across vendors, not your harness's own agents or subagents.\nThe person applies turns to their folder; you cannot.\nWork you ask for comes back to you as a later turn: do not wait for it."
arg "--allowedTools"
arg "Edit(/<folder>/**),Bash(agentbus-api:*),mcp__agentbus"
arg "--mcp-config"
arg "{\"mcpServers\":{\"agentbus\":{\"headers\":{\"Authorization\":\"Bearer ${AGENTBUS_TOKEN}\"},\"type\":\"http\",\"url\":\"http://127.0.0.1:8787/api/v0/mcp\"}}}"
arg "--strict-mcp-config"
arg "--disallowedTools"
arg "Edit(/<data>/permissions.toml),Edit(/<data>/instructions.md),Edit(/<data>/agents.json),Task,Agent,Workflow,ListAgents,SendMessage"
arg "--model"
arg "deepseek/deepseek-v4.1-flash"
arg "--"
arg "one"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "ANTHROPIC_API_KEY="
env "ANTHROPIC_AUTH_TOKEN=test-key"
env "ANTHROPIC_BASE_URL=http://127.0.0.1:8787/s/s1/t/t_1/openrouter"
env "ANTHROPIC_DEFAULT_FABLE_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_SMALL_FAST_MODEL=deepseek/deepseek-v4.1-flash"
env "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1"
env "CLAUDE_CODE_SUBAGENT_MODEL=deepseek/deepseek-v4.1-flash"
env "HOME=<home>"
env "OPENROUTER_API_KEY=test-key"
env "PATH=<data>/bin:/usr/bin:/bin"
cwd <folder>
