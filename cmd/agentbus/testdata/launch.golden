arg "developer_instructions=\"You work through AgentBus, in session s1. A turn is one message to you, your reply and your changes.\\nYour folder is usually your session's own copy of the person's folder. Your edits stay in the copy. They reach the person's folder only when a turn is applied.\\nUse the tools of the agentbus MCP server for AgentBus: list and ask other agents, review, read and stop turns, search this session. AgentBus agents are saved setups across vendors, not your harness's own agents or subagents.\\nThe person applies turns to their folder; you cannot.\\nWork you ask for comes back to you as a later turn: do not wait for it.\""
arg "-c"
arg "mcp_servers.agentbus.url=\"http://127.0.0.1:8787/api/v0/mcp\""
arg "-c"
arg "mcp_servers.agentbus.bearer_token_env_var=\"AGENTBUS_TOKEN\""
arg "-c"
arg "sandbox_workspace_write.network_access=true"
arg "--disable"
arg "multi_agent"
arg "--disable"
arg "multi_agent_v2"
arg "--"
arg "one"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "HOME=<home>"
env "PATH=<data>/bin:/usr/bin:/bin"
cwd <folder>
