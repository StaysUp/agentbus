=== claude lists, model, own instructions
--- turn t_1 harness="claude" access="" model="opus" read_only=false
arg "-p"
arg "--output-format"
arg "json"
arg "--append-system-prompt"
arg "Be brief in s1."
arg "--allowedTools"
arg "Read(/<readfolder>/**),Grep(/<readfolder>/**),Glob(/<readfolder>/**),Edit(/<folder>/**),Bash(go test:*),Bash(git commit:*),Bash(agentbus-api:*)"
arg "--disallowedTools"
arg "Bash(git push:*),Bash(rm -rf:*),Edit(/<data>/permissions.toml),Edit(/<data>/instructions.md),Edit(/<data>/agents.json)"
arg "--model"
arg "opus"
arg "--"
arg "one"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "ANTHROPIC_BASE_URL=http://127.0.0.1:8787/s/s1/t/t_1"
env "HOME=<home>"
env "PATH=<data>/bin:/usr/bin:/bin"
cwd <folder>
turn.started agent="claude" continuity="" replay_from="" model="opus" context=""
session.closed resume_id="sid-0"
