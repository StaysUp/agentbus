arg "--allowedTools"
arg "Edit(/<folder>/**),Bash(agentbus-api:*)"
arg "--disallowedTools"
arg "Edit(/<data>/permissions.toml),Edit(/<data>/instructions.md),Edit(/<data>/agents.json)"
arg "--"
arg "one"
env "AGENTBUS_ASKED_BY_SESSION=s0"
env "AGENTBUS_ASKED_BY_TURN=t_0"
