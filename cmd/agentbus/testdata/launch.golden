=== claude openrouter
--- turn t_1 harness="claude" access="openrouter" model="deepseek/deepseek-v4.1-flash" read_only=false
arg "-p"
arg "--output-format"
arg "json"
arg "--append-system-prompt"
arg "You work through AgentBus, in session s1. A turn is one message to you, your reply and your changes.\nYour folder is usually your session's own copy of the person's folder. Your edits stay in the copy. They reach the person's folder only when a turn is applied.\nCall AgentBus with agentbus-api METHOD PATH [JSON]. Replace T with a turn id.\n- List this session's turns, with each id, number, state and cost: agentbus-api GET /api/v0/turns\n- Apply a turn to the person's folder (its changes and the earlier turns' that are not applied yet): agentbus-api POST /api/v0/turns/T/apply\n- Ask another agent to review a turn: agentbus-api POST /api/v0/turns/T/review '{\"agent\":\"<agent id>\"}'. Pick an agent other than the one that did the turn. List the agents: agentbus-api GET /api/v0/agents. These are AgentBus agents, not your harness's own agents or subagents.\n- Read a turn, its state, cost and a review's verdict: agentbus-api GET /api/v0/turns/T\n- Stop a turn: agentbus-api POST /api/v0/turns/T/stop\n- Search this session's history: agentbus-api GET \"/api/v0/sessions/s1/search?q=<text>\", with <text> URL-encoded.\nWork you ask for comes back to you as a later turn: do not wait for it. More: agentbus-api GET /docs/llms.txt"
arg "--allowedTools"
arg "Edit(/<folder>/**),Bash(agentbus-api:*)"
arg "--disallowedTools"
arg "Edit(/<data>/permissions.toml),Edit(/<data>/instructions.md),Edit(/<data>/agents.json)"
arg "--model"
arg "deepseek/deepseek-v4.1-flash"
arg "--"
arg "one"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "ANTHROPIC_API_KEY="
env "ANTHROPIC_AUTH_TOKEN=test-key"
env "ANTHROPIC_BASE_URL=http://127.0.0.1:8787/s/s1/t/t_1/openrouter"
env "ANTHROPIC_DEFAULT_FABLE_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_MODEL=deepseek/deepseek-v4.1-flash"
env "ANTHROPIC_SMALL_FAST_MODEL=deepseek/deepseek-v4.1-flash"
env "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1"
env "CLAUDE_CODE_SUBAGENT_MODEL=deepseek/deepseek-v4.1-flash"
env "HOME=<home>"
env "OPENROUTER_API_KEY=test-key"
env "PATH=<data>/bin:/usr/bin:/bin"
cwd <folder>
turn.started agent="claude" continuity="" replay_from="" model="deepseek/deepseek-v4.1-flash" context=""
session.closed resume_id="sid-0"
