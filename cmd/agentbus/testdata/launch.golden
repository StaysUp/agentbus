=== claude subscription, then resume
--- turn t_1 harness="claude" access="" model=""
arg "--settings"
arg "{\"apiKeyHelper\":\"\",\"env\":{\"ANTHROPIC_BASE_URL\":\"http://127.0.0.1:8787/s/s1/t/t_1\",\"ANTHROPIC_CUSTOM_HEADERS\":\"\",\"ANTHROPIC_UNIX_SOCKET\":\"\",\"CLAUDE_CODE_USE_ANTHROPIC_AWS\":\"\",\"CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD\":\"\",\"CLAUDE_CODE_USE_BEDROCK\":\"\",\"CLAUDE_CODE_USE_FOUNDRY\":\"\",\"CLAUDE_CODE_USE_GATEWAY\":\"\",\"CLAUDE_CODE_USE_MANTLE\":\"\",\"CLAUDE_CODE_USE_VERTEX\":\"\",\"NO_PROXY\":\"localhost,127.0.0.1,::1,127.0.0.1:8787\",\"no_proxy\":\"localhost,127.0.0.1,::1,127.0.0.1:8787\"}}"
arg "-p"
arg "--output-format"
arg "json"
arg "--append-system-prompt"
arg "You work through AgentBus, in session s1. A turn is one message to you, your reply and your changes.\nYour folder is usually your session's own copy of the person's folder. Your edits stay in the copy. They reach the person's folder only when a turn is applied.\nUse the agentbus MCP tools to ask other saved agents (any vendor) for work (ask_agent) or to have one review a turn (review_turn). AgentBus agents are saved setups across vendors, not your harness's own agents or subagents.\nTo read turns and their diffs, search this session, or stop a turn, use agentbus-api (GET /api/v0/turns, GET /api/v0/turns/T/diff, POST /api/v0/turns/T/stop). A short guide to every route is at agentbus-api GET /docs/llms.txt.\nThe person applies your changes to their folder; you cannot.\nWork you ask for comes back to you as a later turn: do not wait for it."
arg "--allowedTools"
arg "Edit(/<folder>/**),Bash,mcp__agentbus"
arg "--mcp-config"
arg "{\"mcpServers\":{\"agentbus\":{\"headers\":{\"Authorization\":\"Bearer ${AGENTBUS_TOKEN}\"},\"type\":\"http\",\"url\":\"http://127.0.0.1:8787/api/v0/mcp\"}}}"
arg "--no-chrome"
arg "--disallowedTools"
arg "Edit(/<data>/permissions.toml),Edit(/<data>/instructions.md),Edit(/<data>/agents.json),Task,Agent,Workflow,ListAgents,SendMessage"
arg "--"
arg "one"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "HOME=<home>"
env "PATH=<data>/bin:/usr/bin:/bin"
env "PWD=<folder>"
cwd <folder>
turn.started agent="claude" continuity="" replay_from="" model="" context=""
context.added instructions=844 mcp_instructions=327
run.ended resume_id="sid-0"
--- turn t_2 harness="" access="" model=""
arg "--settings"
arg "{\"apiKeyHelper\":\"\",\"env\":{\"ANTHROPIC_BASE_URL\":\"http://127.0.0.1:8787/s/s1/t/t_2\",\"ANTHROPIC_CUSTOM_HEADERS\":\"\",\"ANTHROPIC_UNIX_SOCKET\":\"\",\"CLAUDE_CODE_USE_ANTHROPIC_AWS\":\"\",\"CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD\":\"\",\"CLAUDE_CODE_USE_BEDROCK\":\"\",\"CLAUDE_CODE_USE_FOUNDRY\":\"\",\"CLAUDE_CODE_USE_GATEWAY\":\"\",\"CLAUDE_CODE_USE_MANTLE\":\"\",\"CLAUDE_CODE_USE_VERTEX\":\"\",\"NO_PROXY\":\"localhost,127.0.0.1,::1,127.0.0.1:8787\",\"no_proxy\":\"localhost,127.0.0.1,::1,127.0.0.1:8787\"}}"
arg "-p"
arg "--output-format"
arg "json"
arg "--append-system-prompt"
arg "You work through AgentBus, in session s1. A turn is one message to you, your reply and your changes.\nYour folder is usually your session's own copy of the person's folder. Your edits stay in the copy. They reach the person's folder only when a turn is applied.\nUse the agentbus MCP tools to ask other saved agents (any vendor) for work (ask_agent) or to have one review a turn (review_turn). AgentBus agents are saved setups across vendors, not your harness's own agents or subagents.\nTo read turns and their diffs, search this session, or stop a turn, use agentbus-api (GET /api/v0/turns, GET /api/v0/turns/T/diff, POST /api/v0/turns/T/stop). A short guide to every route is at agentbus-api GET /docs/llms.txt.\nThe person applies your changes to their folder; you cannot.\nWork you ask for comes back to you as a later turn: do not wait for it."
arg "--resume"
arg "sid-0"
arg "--allowedTools"
arg "Edit(/<folder>/**),Bash,mcp__agentbus"
arg "--mcp-config"
arg "{\"mcpServers\":{\"agentbus\":{\"headers\":{\"Authorization\":\"Bearer ${AGENTBUS_TOKEN}\"},\"type\":\"http\",\"url\":\"http://127.0.0.1:8787/api/v0/mcp\"}}}"
arg "--no-chrome"
arg "--disallowedTools"
arg "Edit(/<data>/permissions.toml),Edit(/<data>/instructions.md),Edit(/<data>/agents.json),Task,Agent,Workflow,ListAgents,SendMessage"
arg "--"
arg "next t_2"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "HOME=<home>"
env "PATH=<data>/bin:/usr/bin:/bin"
env "PWD=<folder>"
cwd <folder>
turn.started agent="claude" continuity="resume" replay_from="" model="" context=""
context.added instructions=844 mcp_instructions=327
run.ended resume_id="sid-1"
