arg "json"
arg "--settings"
arg "{\"allowNonWorkspaceAccess\":false,\"permissions\":{\"allow\":[\"write_file(<folder>)\",\"edit_file(<folder>)\",\"command(agentbus-api)\"],\"deny\":[\"write_file(<data>/permissions.toml)\",\"edit_file(<data>/permissions.toml)\",\"write_file(<data>/instructions.md)\",\"edit_file(<data>/instructions.md)\",\"write_file(<data>/agents.json)\",\"edit_file(<data>/agents.json)\"]}}"
arg "--print=one"
env "AGENTBUS_LAUNCH_DIR=<launch>"
env "AGENTBUS_TOKEN=<token>
env "AGENTBUS_URL=http://127.0.0.1:8787"
env "CLOUD_CODE_URL=http://127.0.0.1:8787/s/s1/t/t_1"
env "HOME=<home>"
env "PATH=<data>/bin:/usr/bin:/bin"
